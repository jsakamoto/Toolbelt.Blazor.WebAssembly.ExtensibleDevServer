<Project>

  <Target Name="BzExDevSvr_MyExtension_PrepareResponseFile" BeforeTargets="BzExDevSvr_GenerateResponseFile">
    <ItemGroup>
      <BzExDevSvrAssembly Include="MyExtension" />
      <BzExDevSvrDeps Include="$(MSBuildThisFileDirectory)../tools/net10.0/MyExtension.deps.json" />
      <!--
      <BzExDevSvrEnvValue Include="NAME1=value1" />
      <BzExDevSvrEnvValue Include="NAME2=value2" />
      -->
    </ItemGroup>
  </Target>

</Project>